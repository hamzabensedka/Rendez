# Planity API environment — copy to apps/api/.env and fill in.
# Every REQUIRED var below is validated at boot by src/env.validation.ts.

# ── Required ───────────────────────────────────────────────────────────
# Postgres connection string (Supabase: Settings → Database → Connection string)
DATABASE_URL=
# JWT signing secrets — generate with: node scripts/generate-secrets.js
JWT_ACCESS_SECRET=            # min 16 chars, use 32+ random
JWT_REFRESH_SECRET=           # min 16 chars, use 32+ random

# ── Optional ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # 'production' hides Swagger + disables pino-pretty

# Redis cache (optional; falls back to in-process memory per instance)
REDIS_URL=

# CORS origins, comma-separated. Dev also allows localhost / 127.0.0.1
# (Expo web defaults to http://localhost:8081).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Log level for pino (default: info)
LOG_LEVEL=info

# Email notifications — without a key the pipeline runs in log-only mode
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=bookings@planity.app

# Set to 'off' to disable the in-process reminder scheduler
REMINDER_SCHEDULER=
